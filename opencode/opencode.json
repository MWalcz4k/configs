{
  "$schema": "https://opencode.ai/config.json",
"autoupdate": true, 
  "permission": {
    "external_directory": {
      "~/workspace/**": "allow",
      "~/go/pkg/mod/**": "allow"
    },
    "bash": {
      "rm *": "ask",
      "*": "allow" 
    },
    "edit": {
      "*": "allow",
      "~/go/pkg/mod/**": "deny"
    }
  }
}
