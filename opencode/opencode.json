{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "permission": {
    "external_directory": {
      "~/workspace/**": "allow",
      "~/go/pkg/mod/**": "allow",
      "/tmp/**": "allow"
    },
    "bash": {
      "rm *": "ask",
      "*": "allow"
    },
    "edit": {
      "*": "allow",
      "~/go/pkg/mod/**": "deny"
    }
  },
  "mcp": {
    "jira": {
      "type": "remote",
      "url": "https://mcp.atlassian.com/v1/mcp",
      "enabled": false
    }
  }
}
